# Copy to .env and fill in.

# Postgres connection string, read by lib/prisma.ts through the pg driver adapter.
DATABASE_URL=postgresql://user:password@localhost:5432/ghost

# Clerk. Both keys come from the API Keys page of your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people to sign in and sign up. Read in proxy.ts.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up